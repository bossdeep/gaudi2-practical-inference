{
  "$id": "https://opencat-research.org/schemas/research-submission-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "type": "string"
        },
        "revision": {
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "commit"
      ],
      "type": "object"
    },
    "failedSearches": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "finding": {
      "maxLength": 8000,
      "minLength": 20,
      "type": "string"
    },
    "method": {
      "maxLength": 2000,
      "minLength": 20,
      "type": "string"
    },
    "objectiveId": {
      "const": "gaudi2-practical-inference",
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "projectId": {
      "const": "gaudi2-practical-inference",
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "recommendedAction": {
      "maxLength": 2000,
      "minLength": 5,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "maxLength": 2000,
      "minLength": 5,
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "contentHash": {
            "pattern": "^[0-9a-fA-F]{64}$",
            "type": [
              "string",
              "null"
            ]
          },
          "documentDate": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": [
              "string",
              "null"
            ]
          },
          "exactExcerpt": {
            "maxLength": 4000,
            "minLength": 10,
            "type": "string"
          },
          "kind": {
            "enum": [
              "vendor-doc",
              "release-notes",
              "benchmark",
              "specification",
              "reference-code",
              "paper",
              "blog",
              "community-report"
            ]
          },
          "relevance": {
            "maxLength": 1000,
            "minLength": 10,
            "type": "string"
          },
          "retrievedAt": {
            "format": "date-time",
            "maxLength": 40,
            "minLength": 20,
            "type": "string"
          },
          "title": {
            "maxLength": 300,
            "minLength": 3,
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2000,
            "minLength": 9,
            "pattern": "^https://",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "title",
          "url",
          "documentDate",
          "retrievedAt",
          "exactExcerpt",
          "relevance",
          "contentHash"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "submissionId": {
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "type": "string"
    },
    "summary": {
      "maxLength": 280,
      "minLength": 20,
      "type": "string"
    },
    "uncertainty": {
      "maxLength": 2000,
      "minLength": 5,
      "type": "string"
    },
    "workItemId": {
      "enum": [
        "question-direct-attach",
        "question-graph-dispatch",
        "question-prefill-batching",
        "question-quant-model",
        "question-topology-transfer"
      ],
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "submissionId",
    "projectId",
    "objectiveId",
    "base",
    "workItemId",
    "summary",
    "method",
    "finding",
    "scope",
    "uncertainty",
    "failedSearches",
    "recommendedAction",
    "sources"
  ],
  "title": "OpenCat Research submission",
  "type": "object"
}
